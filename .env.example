# ---------------------------------------------------------------------------
# T-Mem environment configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Every variable below is optional unless marked REQUIRED; commented-out lines
# show the built-in default that applies when the variable is unset.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# LLM endpoint (OpenAI-compatible chat/completions)          [REQUIRED]
# Any endpoint that speaks the OpenAI Chat Completions protocol works:
# OpenAI, Azure OpenAI, vLLM, Ollama, SiliconFlow, LM Studio, ...
# ---------------------------------------------------------------------------
T_MEM_LLM_BASE_URL=https://api.openai.com/v1
T_MEM_LLM_API_KEY=sk-your-key-here
# (T_MEM_LLM_API_KEY falls back to OPENAI_API_KEY if unset)

# ---------------------------------------------------------------------------
# Embedding endpoint (OpenAI-compatible POST /embeddings)
# ---------------------------------------------------------------------------
# Leave unset to reuse T_MEM_LLM_BASE_URL / API key.
#T_MEM_EMBEDDING_BASE_URL=https://api.openai.com/v1
#T_MEM_EMBEDDING_MODEL=bge-m3
#T_MEM_EMBEDDING_API_KEY=

# ---------------------------------------------------------------------------
# Reranker endpoint (OpenAI-compatible POST /rerank)
# The paper pipeline uses a reranker (bge-reranker-v2-m3) by default.
# Point this at any service exposing the standard /rerank API
# (e.g. vLLM, Jina, SiliconFlow). Set T_MEM_USE_RERANKER=false to disable.
# ---------------------------------------------------------------------------
T_MEM_RERANKER_BASE_URL=https://api.openai.com/v1
T_MEM_RERANKER_MODEL=bge-reranker-v2-m3
#T_MEM_RERANKER_API_KEY=
#T_MEM_USE_RERANKER=true

# ---------------------------------------------------------------------------
# Model aliases (public, OpenAI-compatible model names)
# ---------------------------------------------------------------------------
#T_MEM_MEMORY_BUILD_MODEL=gpt-4.1-mini
#T_MEM_LOCOMO_QA_MODEL=gpt-4o-mini
#T_MEM_LOCOMO_JUDGE_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Pipeline / experiment
# ---------------------------------------------------------------------------
#T_MEM_EXPERIMENT_NAME=T-mem
#T_MEM_RESULTS_DIR=./results
#T_MEM_DATA_FILE=./data/locomo10.json
#T_MEM_NUM_CONV=10
#T_MEM_MAX_CONCURRENCY=14

# ---------------------------------------------------------------------------
# LLM call robustness (applies to every stage)
# ---------------------------------------------------------------------------
#T_MEM_TIMEOUT=180              # per-request timeout, seconds
#T_MEM_RETRIES=3                # transport-level retries
#T_MEM_JSON_MAX_RETRIES=3       # extra retries when JSON parsing fails
#T_MEM_RATELIMIT_BACKOFF=12     # base backoff (s) after HTTP 429

# ---------------------------------------------------------------------------
# Retrieval cascade hyper-parameters (stage 6)
# ---------------------------------------------------------------------------
#T_MEM_INITIAL_CANDIDATES=250   # BM25/vector candidate pool per layer
#T_MEM_TOPIC_TOP_K=15           # layer 1: topics kept
#T_MEM_SCENE_TOP_K=24           # layer 2: scenes kept
#T_MEM_ITEM_TOP_K=40            # layer 3: memory items kept
#T_MEM_FINAL_KEEP_SCENE=5       # scenes written into the QA context
#T_MEM_FINAL_KEEP_ITEM=15       # items written into the QA context

# ---------------------------------------------------------------------------
# Scene / Horizon triggers (stage 4 extraction, stage 5 recall)
# ---------------------------------------------------------------------------
#T_MEM_ENABLE_SCENE_HORIZON_TRIGGERS=true
#T_MEM_SCENE_HORIZON_EXTRACT_CONCURRENCY=14
#T_MEM_SCENE_HORIZON_EXTRACT_TIMEOUT=240
#T_MEM_SCENE_HORIZON_NO_RESUME=false   # true = ignore existing stage4 output
#T_MEM_SCENE_HORIZON_TOPK=10           # triggers recalled per query
#T_MEM_SCENE_HORIZON_RRF_K=30          # reciprocal-rank-fusion constant

# ---------------------------------------------------------------------------
# Entity / Bridge triggers (built by stage 4b, consumed by stage 6)
# T_MEM_ENTITY_BRIDGE_TRIGGER_ENABLED governs BOTH sides: setting it to
# 0/false/no/off skips the stage-4b build and disables the stage-6 recall path.
# ---------------------------------------------------------------------------
#T_MEM_ENTITY_BRIDGE_TRIGGER_ENABLED=true
#T_MEM_ENTITY_BRIDGE_TRIGGER_DIR=            # default: <exp>/entity_bridge_triggers
#T_MEM_ENTITY_BRIDGE_TRIGGER_TOPK=10
#T_MEM_ENTITY_BRIDGE_TRIGGER_GATE=0.85       # similarity gate, clamped to [0,1]

# ---------------------------------------------------------------------------
# Persona / profile memory (stage 7)
# ---------------------------------------------------------------------------
#T_MEM_PERSONA_CONCURRENCY=1
#T_MEM_PERSONA_TIMEOUT=300
#T_MEM_PROFILE_DEBUG=0          # 1 = dump per-window profile diagnostics

# ---------------------------------------------------------------------------
# QA generation & judging (stage 8 + benchmark_eval)
# ---------------------------------------------------------------------------
#T_MEM_QA_CONCURRENCY=14
#T_MEM_JUDGE_NUM_RUNS=3         # LoCoMo default 3; LoCoMo-Plus default 1
#T_MEM_JUDGE_WORKERS=10         # LoCoMo judge threads
#T_MEM_JUDGE_CONCURRENCY=16     # LoCoMo-Plus judge threads
#T_MEM_LOCOMO_PLUS_TOPK=10
#T_MEM_LOCOMO_PLUS_CONTENT=summary          # summary | description | dialogue
#T_MEM_LOCOMO_PLUS_JUDGE_PROMPT=A_paper_original

# ---------------------------------------------------------------------------
# Ablation switches (leave unset to reproduce the paper configuration)
# ---------------------------------------------------------------------------
#T_MEM_FLAT_FACT_RETRIEVAL=false  # true = flat fact retrieval, bypass cascade
#T_MEM_SKIP_TOPIC_LAYER=false     # true = drop layer 1 (topics)

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
#T_MEM_FAILURE_LOG=./failure.jsonl   # JSONL log of LLM JSON-parse failures
#T_MEM_COST_LOG=./cost.jsonl         # unset = cost accounting fully disabled
#T_MEM_COST_STAGE=                   # label written into each cost record

# ---------------------------------------------------------------------------
# Paths wired automatically by scripts/*.sh — override only for custom layouts
# ---------------------------------------------------------------------------
#T_MEM_ROOT=                     # repository root (auto-detected)
#T_MEM_LOCOMO_FILE=              # LoCoMo source json
#T_MEM_LOCOMO_PLUS_FILE=         # LoCoMo-Plus source json
#T_MEM_LOCOMO10_FILE=            # locomo10.json used by LoCoMo-Plus QA
#T_MEM_STITCHED_PLUS_FILE=       # stage0 stitched LoCoMo-Plus conversations
#T_MEM_PERSONA_STORE_ROOT=       # persona store consumed at QA time
